      ttg.local_dealloc %66 : !ttg.memdesc<2x8x256xi8, #shared2, #smem, mutable>
      %98 = arith.truncf %97 : tensor<64x256xf32, #mma> to tensor<64x256xbf16, #mma>
      %99 = arith.extsi %8 : tensor<64xi32, #ttg.slice<{dim = 1, parent = #mma}>> to tensor<64xi64, #ttg.slice<{dim = 1, parent = #mma}>>
      %100 = arith.extsi %6 : i32 to i64
      %101 = tt.splat %100 : i64 -> tensor<64xi64, #ttg.slice<{dim = 1, parent = #mma}>>
      %102 = arith.addi %101, %99 : tensor<64xi64, #ttg.slice<{dim = 1, parent = #mma}>>
      %103 = arith.extsi %15 : tensor<256xi32, #ttg.slice<{dim = 0, parent = #mma}>> to tensor<256xi64, #ttg.slice<{dim = 0, parent = #mma}>>
      %104 = arith.extsi %13 : i32 to i64
      %105 = tt.splat %104 : i64 -> tensor<256xi64, #ttg.slice<{dim = 0, parent = #mma}>>
      %106 = arith.addi %105, %103 : tensor<256xi64, #ttg.slice<{dim = 0, parent = #mma}>>
      %107 = tt.expand_dims %102 {axis = 1 : i32} : tensor<64xi64, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<64x1xi64, #mma>
      %108 = arith.extsi %arg11 : i32 to i64
      %109 = tt.expand_dims %99 {axis = 1 : i32} : tensor<64xi64, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<64x1xi64, #mma>
      %110 = arith.muli %108, %100 : i64
      %111 = tt.splat %108 : i64 -> tensor<64x1xi64, #mma>
      %112 = arith.muli %111, %109 : tensor<64x1xi64, #mma>
      %113 = tt.addptr %arg2, %110 : !tt.ptr<bf16>, i64
      %114 = arith.trunci %112 : tensor<64x1xi64, #mma> to tensor<64x1xi32, #mma>
      %115 = tt.expand_dims %106 {axis = 0 : i32} : tensor<256xi64, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x256xi64, #mma>
      %116 = tt.broadcast %114 : tensor<64x1xi32, #mma> -> tensor<64x256xi32, #mma>
      %117 = tt.expand_dims %103 {axis = 0 : i32} : tensor<256xi64, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x256xi64, #mma>
      %118 = tt.broadcast %117 : tensor<1x256xi64, #mma> -> tensor<64x256xi64, #mma>
      %119 = tt.addptr %113, %104 : !tt.ptr<bf16>, i64
      %120 = arith.trunci %118 : tensor<64x256xi64, #mma> to tensor<64x256xi32, #mma>
      %121 = arith.addi %120, %116 : tensor<64x256xi32, #mma>
      %122 = arith.extsi %arg5 : i32 to i64
      %123 = tt.splat %122 : i64 -> tensor<64x1xi64, #mma>
      %124 = arith.cmpi slt, %107, %123 : tensor<64x1xi64, #mma>
      %125 = arith.extsi %arg6 : i32 to i64
      %126 = tt.splat %125 : i64 -> tensor<1x256xi64, #mma>
      %127 = arith.cmpi slt, %115, %126 : tensor<1x256xi64, #mma>
      %128 = tt.broadcast %124 : tensor<64x1xi1, #mma> -> tensor<64x256xi1, #mma>
      %129 = tt.broadcast %127 : tensor<1x256xi1, #mma> -> tensor<64x256xi1, #mma>
      %130 = arith.andi %128, %129 : tensor<64x256xi1, #mma>
      amdgpu.buffer_store %98, %119[%121], %130 : tensor<64x256xbf16, #mma>
    }
    tt.return
  }
}
