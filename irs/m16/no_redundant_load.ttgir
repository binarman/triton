      %136 = tt.expand_dims %122 {axis = 0 : i32} : tensor<128xi64, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x128xi64, #mma>
      %137 = tt.broadcast %136 : tensor<1x128xi64, #mma> -> tensor<16x128xi64, #mma>
      %138 = tt.addptr %132, %123 : !tt.ptr<f32>, i64
      %139 = arith.trunci %137 : tensor<16x128xi64, #mma> to tensor<16x128xi32, #mma>
      %140 = arith.addi %139, %135 : tensor<16x128xi32, #mma>
      %141 = arith.muli %1, %arg10 : i32
      %142 = tt.addptr %138, %141 : !tt.ptr<f32>, i32
      %143 = arith.extsi %arg5 : i32 to i64
      %144 = tt.splat %143 : i64 -> tensor<16x1xi64, #mma>
      %145 = arith.cmpi slt, %126, %144 : tensor<16x1xi64, #mma>
      %146 = arith.extsi %arg6 : i32 to i64
      %147 = tt.splat %146 : i64 -> tensor<1x128xi64, #mma>
      %148 = arith.cmpi slt, %134, %147 : tensor<1x128xi64, #mma>
      %149 = tt.broadcast %145 : tensor<16x1xi1, #mma> -> tensor<16x128xi1, #mma>
      %150 = tt.broadcast %148 : tensor<1x128xi1, #mma> -> tensor<16x128xi1, #mma>
      %151 = arith.andi %149, %150 : tensor<16x128xi1, #mma>
