      %98 = tt.expand_dims %93 {axis = 1 : i32} : tensor<32xi64, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<32x1xi64, #mma>
      %99 = arith.extsi %arg11 : i32 to i64
      %100 = tt.expand_dims %90 {axis = 1 : i32} : tensor<32xi64, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<32x1xi64, #mma>
      %101 = arith.muli %99, %91 : i64
      %102 = tt.splat %99 : i64 -> tensor<32x1xi64, #mma>
      %103 = arith.muli %102, %100 : tensor<32x1xi64, #mma>
      %104 = tt.addptr %arg2, %101 : !tt.ptr<bf16>, i64
      %105 = arith.trunci %103 : tensor<32x1xi64, #mma> to tensor<32x1xi32, #mma>
      %106 = tt.expand_dims %97 {axis = 0 : i32} : tensor<256xi64, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x256xi64, #mma>
      %107 = tt.broadcast %105 : tensor<32x1xi32, #mma> -> tensor<32x256xi32, #mma>
      %108 = tt.expand_dims %94 {axis = 0 : i32} : tensor<256xi64, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x256xi64, #mma>
      %109 = tt.broadcast %108 : tensor<1x256xi64, #mma> -> tensor<32x256xi64, #mma>
      %110 = tt.addptr %104, %95 : !tt.ptr<bf16>, i64
      %111 = arith.trunci %109 : tensor<32x256xi64, #mma> to tensor<32x256xi32, #mma>
      %112 = arith.addi %111, %107 : tensor<32x256xi32, #mma>
      %113 = arith.extsi %arg5 : i32 to i64
      %114 = tt.splat %113 : i64 -> tensor<32x1xi64, #mma>
      %115 = arith.cmpi slt, %98, %114 : tensor<32x1xi64, #mma>
      %116 = arith.extsi %arg6 : i32 to i64
      %117 = tt.splat %116 : i64 -> tensor<1x256xi64, #mma>
      %118 = arith.cmpi slt, %106, %117 : tensor<1x256xi64, #mma>
      %119 = tt.broadcast %115 : tensor<32x1xi1, #mma> -> tensor<32x256xi1, #mma>
      %120 = tt.broadcast %118 : tensor<1x256xi1, #mma> -> tensor<32x256xi1, #mma>
      %121 = arith.andi %119, %120 : tensor<32x256xi1, #mma>
      amdgpu.buffer_store %89, %110[%112], %121 : tensor<32x256xbf16, #mma>
    }
    tt.return
  }
}
