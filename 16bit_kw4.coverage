if (elemBitWidth == 16 && kWidth == 4) {
    if (write_width < 8) {    // 1/2 banks per access
      pad1 = k:+4
      pad2_interval = k * 16
      pad2_padding = max(512 / nonk, 4)
    } else {                  // 4 banks per access
      pad1 = k:+8
      pad2_interval = k * 8
      pad2_padding = max(512 / nonk, 8)
    }
}

